    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->

    <group_state name="standing" group="all">
        <joint name="root_joint" value="0 0 0.85478727 0 0 0 1"/>

        <joint name="R_HipRoll_Joint"     value="0"/>
        <joint name="R_HipPitch_Joint"    value="0.47"/>
        <joint name="R_HipYaw_Joint"      value="0"/>
        <joint name="R_Knee_Joint"        value="-0.56"/>
        <joint name="R_AnklePitch_Joint"  value="-0.07"/>
        <joint name="R_AnkleRoll_Joint"   value="0"/>

        <joint name="R_ShoulderPitch_Joint" value="0"/>
        <joint name="R_ShoulderRoll_Joint" value="0"/>
        <joint name="R_ShoulderYaw_Joint" value="0"/>
        <joint name="R_Elbow_Joint" value="0"/>
        <joint name="R_WristYaw_Joint" value="0"/>
        <joint name="R_WristPitch_Joint" value="0"/>
        <joint name="R_WristRoll_Joint" value="0"/>

        <joint name="L_HipRoll_Joint"     value="0"/>
        <joint name="L_HipPitch_Joint"    value="-0.47"/>
        <joint name="L_HipYaw_Joint"      value="0"/>
        <joint name="L_Knee_Joint"        value="-0.56"/>
        <joint name="L_AnklePitch_Joint"  value="0.07"/>
        <joint name="L_AnkleRoll_Joint"   value="0"/>

        <joint name="L_ShoulderPitch_Joint" value="0"/>
        <joint name="L_ShoulderRoll_Joint" value="0"/>
        <joint name="L_ShoulderYaw_Joint" value="0"/>
        <joint name="L_Elbow_Joint" value="0"/>
        <joint name="L_WristYaw_Joint" value="0"/>
        <joint name="L_WristPitch_Joint" value="0"/>
        <joint name="L_WristRoll_Joint" value="0"/>

        <joint name="WaistYaw_Joint" value="0"/>
        <joint name="WaistRoll_Joint" value="0"/>
        <joint name="WaistPitch_Joint" value="0"/>

        <joint name="NeckPitch_Joint" value="0"/>
        <joint name="NeckYaw_Joint" value="0"/>
        <joint name="NeckRoll_Joint" value="0"/>
  </group_state>

    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="l_foot" parent_link="L_Foot_Link" group="l_legs"/>
    <end_effector name="r_foot" parent_link="R_Foot_Link" group="r_legs"/>
    <end_effector name="l_hand" parent_link="L_WristRoll_Link" group="l_hands"/>
    <end_effector name="r_hand" parent_link="R_WristRoll_Link" group="r_hands"/>
    
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="root_joint" type="floating" parent_frame="world_frame" child_link="base_link"/>

    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->


</robot>